# Postgres connection string. Matches docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5434/taskmanager?schema=public"

# Secret used to derive session identifiers stored in the database.
# Generate your own with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# First day of the week used by every weekly productivity calculation.
# 0 = Sunday, 1 = Monday, ... 6 = Saturday.
WEEK_STARTS_ON="1"
